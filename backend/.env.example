# Document Intelligence & RAG System - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to version control

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS Configuration
# =============================================================================
# Production Vercel frontend URL (e.g., https://your-app.vercel.app)
# For local development, also allows http://localhost:5173 and http://localhost:3000
FRONTEND_URL=http://localhost:5173

# =============================================================================
# File Upload Limits
# =============================================================================
# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=10
# Comma-separated list of allowed file extensions
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.markdown,.xlsx,.xls,.pptx,.ppt,.csv,.json,.html,.htm,.xml,.rtf,.odt,.ods,.odp

# =============================================================================
# Request Body Limits
# =============================================================================
MAX_QUERY_LENGTH=2000
MAX_CHAT_MESSAGE_LENGTH=4000

# =============================================================================
# Rate Limiting (in-process, resets on service restart)
# =============================================================================
RATE_LIMIT_ENABLED=true
# Upload: 5 requests per hour per IP
UPLOAD_RATE_LIMIT=5
UPLOAD_RATE_WINDOW_SECONDS=3600
# Chat: 30 requests per hour per IP
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=3600
# Search: 60 requests per hour per IP
SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW_SECONDS=3600

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
# For local development: http://localhost:6333
# For production (Qdrant Cloud): https://your-cluster.qdrant.io
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud, leave empty for local
QDRANT_API_KEY=
# Local embedded Qdrant storage path
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_COLLECTION=documents
# Set to true for local embedded Qdrant, false for remote Qdrant Cloud
USE_EMBEDDED_QDRANT=true

# =============================================================================
# Storage Paths (local filesystem - EPHEMERAL on Render Free tier)
# =============================================================================
UPLOAD_DIR=./data/uploads
MARKDOWN_DIR=./data/markdown

# =============================================================================
# Embedding Provider Configuration
# =============================================================================
# Options: openrouter, codecraft, unorouter, mock
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# =============================================================================
# Reranker Provider Configuration
# =============================================================================
RERANKER_PROVIDER=openrouter
RERANKER_MODEL=mistralai/mistral-7b-instruct:free

# =============================================================================
# Generation Provider Configuration
# =============================================================================
GENERATION_PROVIDER=openrouter
GENERATION_MODEL=meta-llama/llama-3.3-70b-instruct:free
GENERATION_FALLBACK_PROVIDER=codecraft
GENERATION_FALLBACK_MODEL=gpt-4o-mini

# =============================================================================
# RAG Parameters
# =============================================================================
TOP_K=20
RERANK_TOP_K=6
MAX_CONTEXT_CHUNKS=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1500

# =============================================================================
# API Keys (required for respective providers)
# =============================================================================
# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# CodeCraft API key
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1

# UnoRouter API key
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.ai/v1