# ============================================================
# APPLICATION
# ============================================================
APP_NAME=document-intelligence
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ============================================================
# QDRANT VECTOR STORAGE
# Supports URL (e.g. http://localhost:6333) or local embedded storage path (e.g. ./data/qdrant_db)
# ============================================================
QDRANT_URL=http://localhost:6333
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_COLLECTION=documents
USE_EMBEDDED_QDRANT=true

# ============================================================
# STORAGE PATHS
# ============================================================
UPLOAD_DIR=./data/uploads
MARKDOWN_DIR=./data/markdown

# ============================================================
# EMBEDDINGS PROVIDER
# Providers: openrouter | codecraft | unorouter | mock
# Note: When using nvidia/nemotron-3-embed-1b:free, EMBEDDING_DIMENSION must be 2048
# ============================================================
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSION=2048

# ============================================================
# RERANKER PROVIDER
# Providers: openrouter | codecraft | unorouter | mock
# ============================================================
RERANKER_PROVIDER=openrouter
RERANKER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ============================================================
# GENERATION PROVIDER
# Providers: openrouter | codecraft | unorouter | mock
# ============================================================
GENERATION_PROVIDER=openrouter
GENERATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GENERATION_FALLBACK_PROVIDER=openrouter
GENERATION_FALLBACK_MODEL=openrouter/free

# ============================================================
# API KEYS & BASE URLS
# ============================================================
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1

# ============================================================
# RAG PARAMETERS
# ============================================================
TOP_K=20
RERANK_TOP_K=6
MAX_CONTEXT_CHUNKS=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1500
